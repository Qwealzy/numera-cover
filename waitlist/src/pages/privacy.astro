---
// The privacy notice. The text lives in src/copy/en.ts (privacy); {{CONTROLLER_NAME}} / {{DELETE_BY}} are filled
// from the build env (buildenv.mjs); the layout is shared with /terms (DocPage).
import DocPage from '../components/DocPage.astro';
import { privacy } from '../copy/en.ts';
import { assertBuildEnv } from '../lib/buildenv.mjs';

const env = assertBuildEnv();
---

<DocPage env={env} title={privacy.title} pending={privacy.pending} updated={privacy.updated} intro={privacy.intro} sections={privacy.sections} back={privacy.back} />
