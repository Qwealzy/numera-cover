---
// S7, the waitlist as a cover ticket. The /api/join body is site/'s plus `email` (required since 2026-10-03; the
// handle and channel became optional). The door changes wording only; no role on the wire.
// On a 200 the fields fold into an issued ticket (shown in place, so nothing below moves).
import { waitlist as Wl, footer as F, CONSENT_VERSION } from '../copy/en.ts';
import { WAITLIST_ENDPOINT, TURNSTILE_SCRIPT } from '../config.ts';
import { MARK_GREEN, MARK_NAVY } from '../lib/geometry.ts';

interface Props {
  sitekey: string;
}
const { sitekey } = Astro.props;
const D = Wl.doors;
const poly = (pts: [number, number][]) => pts.map((p) => p.join(',')).join(' ');
const Nx = Wl.issued.next;
---

<section id="join" class="section join" aria-labelledby="join-title">
  <!-- the Numera mark behind the section: flat SVG first; src/client/joinmark.ts swaps in a turning 3D mark when
       the section comes near, motion is on and WebGL works. Its opacity is the token --join-mark-opacity. -->
  <div class="join-mark" data-join-mark aria-hidden="true">
    <svg class="join-mark-flat" viewBox="0 0 512 512" focusable="false">
      <polygon fill="#435c7a" points={poly(MARK_NAVY)}></polygon>
      <polygon fill="#23b779" points={poly(MARK_GREEN)}></polygon>
    </svg>
  </div>
  <div class="wrap grid">
    <div class="section-head" data-reveal>
      <p class="kicker">{Wl.kicker}</p>
      <h2 id="join-title">{Wl.heading}</h2>
      <p class="intro">{Wl.intro}</p>
      <fieldset class="doors" data-doors>
        <legend class="label">{D.label}</legend>
        <div class="seg">
          <label><input type="radio" name="door" value="trader" checked data-door /><span>{D.trader.tab}</span></label>
          <label><input type="radio" name="door" value="underwriter" data-door /><span>{D.underwriter.tab}</span></label>
        </div>
        <p class="door-note">{D.note}</p>
      </fieldset>
    </div>

    <div class="ticket" data-ticket data-state="idle" data-reveal data-reveal-delay="1">
      <div class="ticket-body">
        <p class="t-title" data-door-title>{D.trader.title}</p>
        <p class="t-line" data-door-line>{D.trader.line}</p>

        <div class="form-wrap">
          <form
            class="form"
            method="post"
            action="/api/join"
            novalidate
            data-form
            data-endpoint={WAITLIST_ENDPOINT}
            data-turnstile={TURNSTILE_SCRIPT}
            data-sitekey={sitekey}
            data-errors={JSON.stringify(Wl.errors)}
            data-sending={Wl.sending}
            data-success={Wl.success}
            data-valid={JSON.stringify(Wl.valid)}
            data-doors={JSON.stringify({ trader: D.trader, underwriter: D.underwriter })}
          >
            <div class="field email-field">
              <label for="wl-email" class="label">{Wl.email.label}</label>
              <div class="input-wrap">
                <input
                  id="wl-email"
                  name="email"
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  autocapitalize="none"
                  spellcheck="false"
                  aria-describedby="wl-email-hint"
                />
              </div>
              <p id="wl-email-hint" class="hint">{Wl.email.hint}</p>
            </div>

            <div class="id-row">
              <fieldset class="channel">
                <legend class="label">{Wl.channel.label}</legend>
                <div class="seg">
                  {Wl.channel.options.map((o, i) => (
                    <label><input type="radio" name="channel" value={o.value} checked={i === 0} /><span>{o.label}</span></label>
                  ))}
                </div>
              </fieldset>

              <div class="field">
                <label for="wl-handle" class="label">{Wl.handle.label}</label>
                <div class="input-wrap">
                  <input
                    id="wl-handle"
                    name="handle"
                    type="text"
                    maxlength="64"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    aria-describedby="wl-handle-hint wl-terms"
                  />
                  <span class="valid-dot" aria-hidden="true"></span>
                </div>
                <p id="wl-handle-hint" class="hint">{Wl.handle.hint}</p>
              </div>
            </div>
            <p id="wl-terms" class="terms mono" aria-live="off"><span data-terms>{Wl.terms.empty}</span> <span class="valid-text" data-valid-text></span></p>

            <div class="check">
              <input id="wl-jurisdiction" name="jurisdiction" type="checkbox" required />
              <label for="wl-jurisdiction">{Wl.jurisdiction}</label>
            </div>
            <div class="check">
              <input id="wl-consent" name="consent" type="checkbox" required />
              <label for="wl-consent">
                {Wl.consent.before}<a href="/privacy">{Wl.consent.link}</a>{Wl.consent.after}
              </label>
            </div>
            <input type="hidden" name="consentVersion" value={CONSENT_VERSION} />

            <div class="cf-box" data-cf-box>
              <div class="cf-turnstile" data-cf></div>
            </div>

            <div class="submit-row">
              <button class="btn btn-primary submit join-cta" type="submit" data-submit><span class="cta-label">{Wl.submit}</span></button>
            </div>
            <noscript><p class="noscript">{Wl.noscript}</p></noscript>
          </form>

          <div class="issued" data-issued tabindex="-1" hidden>
            <p class="i-stamp mono">{Wl.issued.stamp}</p>
            <p class="i-line">{Wl.success}</p>
            <dl class="i-rows mono">
              <div><dt>{Wl.issued.email}</dt><dd data-i="email"></dd></div>
              <div><dt>{Wl.issued.handle}</dt><dd data-i="handle"></dd></div>
              <div><dt>{Wl.issued.channel}</dt><dd data-i="channel"></dd></div>
              <div><dt>{Wl.issued.door}</dt><dd data-i="door"></dd></div>
            </dl>
            <div class="i-next">
              <p class="label i-next-h">{Nx.heading}</p>
              <ol class="i-steps">
                <li style="--i:0"><span class="i-k mono">{Nx.stored[0]}</span><span>{Nx.stored[1]}</span></li>
                <li style="--i:1"><span class="i-k mono">{Nx.when[0]}</span><span>{Nx.when[1]}</span></li>
                <li style="--i:2">
                  <span class="i-k mono">{Nx.leave[0]}</span>
                  <span>{Nx.leave[1]}<a href={F.telegram.href} rel="noopener" target="_blank">{F.telegram.handle}</a>{Nx.leave[2]}<a href={F.x.href} rel="noopener" target="_blank">{F.x.handle}</a>{Nx.leave[3]}</span>
                </li>
              </ol>
            </div>
            <button type="button" class="icon-btn again" data-again>{Wl.issued.again}</button>
          </div>
        </div>
        <p class="status mono" data-status role="status" aria-live="polite" tabindex="-1"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .join {
    isolation: isolate;
  }
  .join-mark {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    display: grid;
    place-items: center;
    opacity: var(--join-mark-opacity);
  }
  .join-mark-flat {
    width: auto;
    height: 72%;
    max-width: 90%;
  }
  .join-mark[data-mode='3d'] .join-mark-flat {
    display: none;
  }
  .join-mark :global(.join-mark-3d) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: start;
  }
  .doors {
    margin: 0.8rem 0 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.5rem;
    scroll-margin-top: calc(var(--nav-h) + 12px);
  }
  .doors legend {
    margin-bottom: 0.5rem;
  }
  .doors .seg {
    justify-self: start;
  }
  .door-note {
    font-size: 0.82rem;
    color: var(--text-label);
  }

  .ticket {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    /* a darker backing than other cards, so the fields stay readable over the mark behind the section */
    background: var(--surface-join);
    overflow: hidden;
  }
  .ticket:global(.shake) {
    animation: shake 300ms linear;
  }
  /* the whole ticket gives a 3 px thud when the ON THE LIST stamp lands */
  .ticket[data-state='success'] {
    animation: ticket-thud 260ms var(--ease-out) 760ms both;
  }
  @keyframes ticket-thud {
    0% {
      transform: none;
    }
    40% {
      transform: translateY(3px);
    }
    100% {
      transform: none;
    }
  }
  .ticket-body {
    display: grid;
    gap: 0.4rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }
  .t-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-accent);
  }
  .t-line {
    color: var(--text-strong);
    margin-bottom: 0.4rem;
  }
  .form-wrap {
    position: relative;
  }
  .form {
    display: grid;
    gap: 0.95rem;
  }
  /* success: the fields keep their space (nothing below moves) and the issued ticket is drawn over them */
  .ticket[data-state='success'] .form {
    visibility: hidden;
  }
  .issued {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding-top: 0.4rem;
    outline: none;
  }
  .issued[hidden] {
    display: none;
  }
  .issued:focus-visible {
    outline: var(--focus);
    outline-offset: 6px;
    border-radius: 6px;
  }
  .i-stamp {
    padding: 0.45rem 0.9rem;
    border: 3px solid var(--green);
    border-radius: 10px;
    color: var(--text-accent);
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.5rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.1;
    transform: rotate(-3deg);
  }
  :global(html[data-motion='on']) .ticket[data-state='success'] .i-stamp {
    animation: slam 340ms ease-in 640ms both;
  }
  @keyframes slam {
    0% {
      transform: rotate(-3deg) scale(1.8);
      opacity: 0;
    }
    35% {
      transform: rotate(-3deg) scale(1);
      opacity: 1;
    }
    60% {
      transform: rotate(-3deg) translateY(3px);
    }
    100% {
      transform: rotate(-3deg);
      opacity: 1;
    }
  }
  .i-line {
    color: var(--text-strong);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .i-rows {
    margin: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.86rem;
  }
  .i-rows div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }
  .i-rows dt {
    color: var(--text-label);
  }
  .i-rows dd {
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }
  /* what happens next: three short steps under a hairline, in the height the folded form keeps */
  .i-next {
    justify-self: stretch;
    display: grid;
    gap: 0.55rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line-strong);
  }
  .i-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    counter-reset: nx;
  }
  .i-steps li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text);
  }
  .i-k {
    position: relative;
    padding-left: 1rem;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-accent);
  }
  /* a filled dot for what is done (stored), rings for what is still to come */
  .i-k::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.32em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid var(--green);
  }
  .i-steps li:first-child .i-k::before {
    background: var(--green);
  }
  .i-steps a {
    color: var(--text-strong);
  }
  :global(html[data-motion='on']) .ticket[data-state='success'] .i-steps li {
    animation: next-in 520ms var(--ease-out) both;
    animation-delay: calc(1180ms + var(--i) * 90ms);
  }
  @keyframes next-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .id-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
  }

  .channel {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.4rem;
  }
  .channel legend {
    margin-bottom: 0.4rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .input-wrap {
    position: relative;
  }
  input:is([type='text'], [type='email']) {
    width: 100%;
    min-height: 52px;
    padding: 0.7rem 2.6rem 0.7rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: 1rem;
  }
  input:is([type='text'], [type='email']):focus-visible {
    outline: var(--focus);
    outline-offset: 2px;
    border-color: var(--green);
  }
  input:is([type='text'], [type='email']):read-only {
    border-style: dashed;
  }
  input[aria-invalid='true'] {
    border: 2px dashed var(--paper);
  }
  .valid-dot {
    position: absolute;
    right: 14px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity var(--t-ui) var(--ease-out), transform var(--t-ui) var(--spring);
  }
  .field[data-valid='y'] .valid-dot {
    opacity: 1;
    transform: none;
    background: var(--green);
  }
  .field[data-valid='n'] .valid-dot {
    opacity: 1;
    transform: none;
    border: 2px solid var(--paper);
  }
  .hint {
    font-size: 0.8rem;
    color: var(--text-label);
  }
  .terms {
    font-size: 0.8rem;
    color: var(--text-strong);
    min-height: 1.6em;
  }
  .valid-text {
    color: var(--text-accent);
    margin-left: 0.5rem;
  }
  .check {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .check input {
    width: 22px;
    height: 22px;
    margin: 0.15rem 0 0;
    accent-color: var(--green);
    cursor: pointer;
  }
  .check input[aria-invalid='true'] {
    outline: 2px dashed var(--paper);
    outline-offset: 3px;
  }
  .check label {
    font-size: 0.93rem;
    color: var(--text);
    cursor: pointer;
  }
  /* Turnstile "flexible" renders 73 px tall in this layout; the box is reserved at that height */
  .cf-box {
    min-height: 73px;
  }
  .submit-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .submit {
    min-width: 12rem;
  }
  .submit[aria-disabled='true'] {
    cursor: progress;
  }
  /* the message slot: two lines reserved with the line box they are drawn in (1.5), so the longest message
     (generic, 64 characters) or the success sentence never moves the FAQ below; three lines on small phones */
  .status {
    min-height: 3em;
    line-height: 1.5;
    font-size: 0.86rem;
    color: var(--text-strong);
    outline: none;
  }
  .status:focus-visible {
    outline: var(--focus);
    outline-offset: 3px;
  }
  .status[data-state='error']::before {
    content: '○ ';
  }
  .status[data-state='ok'] {
    color: var(--text-accent);
    font-weight: 600;
  }
  .status[data-state='ok']::before {
    content: '● ';
  }
  /* success: the issued ticket shows the sentence; the status line keeps its box and still announces it */
  .ticket[data-state='success'] .status {
    clip-path: inset(50%);
  }
  .noscript {
    font-size: 0.9rem;
    color: var(--text-strong);
    padding: 0.6rem 0.8rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: 8px;
  }
  @media (scripting: none) {
    .form > :not(noscript) {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .id-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* phones: "Looks valid for Telegram" can wrap under the terms line; two lines are reserved */
  @media (max-width: 480px) {
    .terms {
      min-height: 3.2em;
    }
  }
  @media (max-width: 389px) {
    .status {
      min-height: 4.5em;
    }
  }
</style>
