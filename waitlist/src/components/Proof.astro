---
// S6, proof: the recorded keeper run e2e_F9_2026-10-02_3 from deployments/testnet-v2.json. Hashes are text with a
// copy button for the `cast receipt` command; no explorer links (none indexes chain 998; D22).
import { proof as Pf } from '../copy/en.ts';
import { RECORDED_RUN as R, VERIFY_RPC } from '../config.ts';

const first = R.buy.block;
const last = R.trigger.block;
const blocks = Array.from({ length: last - first + 1 }, (_, i) => first + i);
const fmt = (n: number) => n.toLocaleString('en-US');
const events = [
  { block: R.buy.block, name: 'buyCover', hash: R.buy.hash, what: 'cover 3 bought from an engine quote' },
  { block: R.drop.block, name: 'setPrice', hash: R.drop.hash, what: 'staged price drop, 50 bps past the level' },
  {
    block: R.trigger.block,
    name: `trigger(${R.coverId})`,
    hash: R.trigger.hash,
    what: `keeper call, ${R.payout / 1e6} mUSDC paid`,
  },
];
const cmd = (h: string) => `cast receipt ${h} --rpc-url ${VERIFY_RPC}`;
---

<section id="proof" class="section proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="kicker">{Pf.kicker}</p>
      <h2 id="proof-title">{Pf.heading}</h2>
      <p class="quote mono">{Pf.quote}</p>
    </div>

    <div class="run" data-run data-first={first} data-last={last} data-reveal>
      <div class="track-wrap">
        <ol class="blocks" aria-label={Pf.track} data-blocks>
          {
            blocks.map((b, i) => {
              const ev = events.find((e) => e.block === b);
              return (
                <li data-b={b} data-ev={ev ? 'y' : 'n'} data-reached="y" style={`--i:${i}`}>
                  <span class="b-tick" aria-hidden="true" />
                  <span class="b-num mono">{String(b).slice(-3)}</span>
                  {ev && <span class="b-ev mono">{ev.name}</span>}
                </li>
              );
            })
          }
        </ol>
        <div class="bracket" style={`--a:${blocks.indexOf(R.drop.block)};--b:${blocks.indexOf(R.trigger.block)};--n:${blocks.length}`} aria-hidden="true"></div>
        <p class="bracket-label mono">{Pf.bracket}</p>
        <div class="playhead-row js-only">
          <button type="button" class="icon-btn" data-run-replay><span aria-hidden="true">↺</span> {Pf.replay}</button>
          <label class="label" for="run-playhead">{Pf.playhead}</label>
          <input id="run-playhead" class="range" type="range" min="0" max={blocks.length - 1} step="1" value={blocks.length - 1} data-run-playhead aria-valuetext={`block ${fmt(last)}`} />
          <output class="mono ph-out" for="run-playhead" data-run-out>{fmt(last)}</output>
        </div>
      </div>

      <ol class="receipts">
        {
          events.map((e, i) => (
            <li class="rc" data-rc-block={e.block} data-reached="y" style={`--i:${i}`}>
              <p class="rc-line mono">
                <span class="type" style={`--n:${`block ${fmt(e.block)} · ${e.name} · ${Pf.status}`.length}`}>
                  block {fmt(e.block)} · <b>{e.name}</b> · {Pf.status}
                </span>
              </p>
              <p class="rc-what">{e.what}</p>
              <p class="rc-hash mono">
                <code title={e.hash}>
                  <span>{e.hash.slice(0, 12)}</span><span class="h-mid">{e.hash.slice(12, -10)}</span><span class="h-dots" aria-hidden="true">…</span><span>{e.hash.slice(-10)}</span>
                </code>
                <button type="button" class="icon-btn copy js-only" data-copy={cmd(e.hash)} aria-label={`${Pf.copy}, block ${fmt(e.block)}`}>{Pf.copy}</button>
              </p>
            </li>
          ))
        }
      </ol>
      <p class="copied mono" data-copied role="status" aria-live="polite"></p>
      <p class="verify">{Pf.verify} <code class="mono">cast receipt &lt;hash&gt; --rpc-url {VERIFY_RPC}</code></p>
    </div>

    <div class="notyet" data-reveal>
      <h3>{Pf.notYetHeading}</h3>
      <ul>
        {Pf.notYet.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .quote {
    font-size: 0.86rem;
    color: var(--text-strong);
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    justify-self: start;
    max-width: 100%;
  }
  .run {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.6rem;
  }
  .track-wrap {
    display: grid;
    gap: 0.6rem;
  }
  .blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    position: relative;
  }
  .blocks::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 15px;
    height: 2px;
    background: var(--line-strong);
  }
  .blocks li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding-top: 0;
  }
  .b-tick {
    width: 12px;
    height: 32px;
    border-radius: 3px;
    border: 1px solid var(--line-strong);
    background: rgb(248 242 239 / 0);
    transition: background-color var(--t-ui) var(--ease-out), border-color var(--t-ui) var(--ease-out);
  }
  .blocks li[data-ev='y'] .b-tick {
    width: 18px;
    border: 2px solid var(--green);
  }
  .blocks li[data-reached='y'] .b-tick {
    background: rgb(248 242 239 / 0.2);
  }
  .blocks li[data-ev='y'] .b-tick {
    background: rgb(35 183 121 / 0);
  }
  .blocks li[data-ev='y'][data-reached='y'] .b-tick {
    background: var(--green);
  }
  .blocks li[data-head='y'] .b-tick {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }
  .b-num {
    font-size: 0.72rem;
    color: var(--text-label);
  }
  .b-ev {
    font-size: 0.72rem;
    color: var(--text-accent);
    white-space: nowrap;
  }
  .bracket {
    position: relative;
    margin-left: calc((var(--a) + 0.5) / var(--n) * 100%);
    width: calc((var(--b) - var(--a)) / var(--n) * 100%);
    border: 1.5px solid var(--green);
    border-top: 0;
    height: 12px;
    border-radius: 0 0 6px 6px;
  }
  .bracket-label {
    font-size: 0.76rem;
    color: var(--text-strong);
    text-align: right;
  }
  .playhead-row {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .playhead-row .range {
    flex: 1 1 12rem;
  }
  .ph-out {
    font-size: 0.9rem;
    color: var(--text-strong);
    min-width: 6.5em;
  }
  .receipts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .rc {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color var(--t-ui) var(--ease-out), opacity var(--t-ui) var(--ease-out);
  }
  .rc[data-reached='n'] {
    opacity: 0.45;
  }
  .rc[data-reached='y'] {
    border-color: var(--line-strong);
  }
  .rc-line {
    font-size: 0.82rem;
    color: var(--text-strong);
  }
  .rc-line b {
    color: var(--text-accent);
  }
  .type {
    display: inline-block;
  }
  :global(html.js[data-motion='on']) .run.typing .type {
    animation: type-in calc(var(--n) * 12ms) steps(var(--n)) both;
    animation-delay: calc(var(--i) * 700ms + 300ms);
  }
  @keyframes type-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .rc-what {
    font-size: 0.9rem;
    color: var(--text);
  }
  .rc-hash {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-label);
  }
  code {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
    color: var(--text);
  }
  .h-dots {
    display: none;
  }
  .copy {
    min-height: 44px;
  }
  .copied {
    min-height: 1.4em;
    font-size: 0.8rem;
    color: var(--text-accent);
  }
  .verify {
    font-size: 0.9rem;
    color: var(--text);
  }
  .verify code {
    font-size: 0.8rem;
    color: var(--text-strong);
  }
  .notyet {
    margin-top: clamp(3rem, 6vw, 4rem);
    display: grid;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius);
  }
  .notyet ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2rem;
  }
  .notyet li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-strong);
  }
  .notyet li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--paper);
  }
  @media (max-width: 960px) {
    .receipts {
      grid-template-columns: minmax(0, 1fr);
    }
    .notyet ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .h-mid {
      display: none;
    }
    .h-dots {
      display: inline;
    }
    .b-ev {
      position: absolute;
      top: 54px;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 0.64rem;
    }
    .blocks {
      margin-bottom: 4.5rem;
    }
  }
</style>
