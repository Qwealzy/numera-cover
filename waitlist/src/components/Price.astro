---
// S4, the price: method in one line, the sourced grid (1 day and 7 days only), evidence lines. The visitor's hero
// setup is placed on the table (src/client/price.ts) and the evidence pair is drawn to scale.
import { price as Pr } from '../copy/en.ts';
// README Evidence; calibration report: in the far tail the plain model expected 0.45 touches, there were 206
const EXPECTED = 0.45;
const SEEN = 206;
const rowPct = (r: string) => parseFloat(r);
---

<section id="price" class="section price" aria-labelledby="price-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="kicker">{Pr.kicker}</p>
      <h2 id="price-title">{Pr.heading}</h2>
    </div>
    <p class="method mono" data-reveal>{Pr.method}</p>

    <div class="grid">
      <figure class="table-fig" data-reveal>
        <table data-table>
          <caption>{Pr.table.caption}</caption>
          <thead>
            <tr>{Pr.table.cols.map((c, i) => <th scope="col" data-col={i === 1 ? '86400' : i === 2 ? '604800' : undefined}>{c}</th>)}</tr>
          </thead>
          <tbody>
            {
              Pr.table.rows.map((r) => (
                <tr data-row={rowPct(r[0])}>
                  <th scope="row" class="mono">{r[0]}</th>
                  <td class="mono" data-dur="86400" data-range={r[1]}>{r[1]}</td>
                  <td class="mono" data-dur="604800" data-range={r[2]}>{r[2]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="you mono js-only" data-you></p>
        <figcaption>{Pr.footnote} {Pr.readoutNote}</figcaption>
      </figure>

      <div class="evidence" data-reveal data-reveal-delay="1">
        <h3 class="label">{Pr.evidenceHeading}</h3>
        <ul>
          {
            Pr.evidence.map((e, i) => (
              <li>
                <span class="ev-fig mono">{e.fig}</span>
                <span class="ev-text">{e.text}</span>
                {i === 0 && (
                  <span class="bars" aria-hidden="true">
                    <span class="bar-row">
                      <span class="bar-l mono">{EXPECTED}</span>
                      <span class="bar-track"><span class="bar bar-model" style={`--w:${((EXPECTED / SEEN) * 100).toFixed(3)}%`}></span></span>
                      <span class="bar-n mono">{Pr.bars.model}</span>
                    </span>
                    <span class="bar-row">
                      <span class="bar-l mono">{SEEN}</span>
                      <span class="bar-track"><span class="bar bar-seen" style="--w:100%"></span></span>
                      <span class="bar-n mono">{Pr.bars.seen}</span>
                    </span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
        <p class="ev-src">{Pr.evidenceSource}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .method {
    margin-top: 1.75rem;
    max-width: 62rem;
    padding: 1rem 1.2rem;
    border-left: 2px solid var(--green);
    background: rgb(34 55 78 / 0.25);
    border-radius: 0 10px 10px 0;
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--text-strong);
  }
  .grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  figure {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  caption {
    caption-side: top;
    text-align: left;
    padding-bottom: 0.8rem;
    font-size: 0.82rem;
    color: var(--text-label);
  }
  th,
  td {
    padding: 0.85rem 0.6rem;
    text-align: right;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--t-ui) var(--ease-out), box-shadow var(--t-ui) var(--ease-out);
  }
  thead th {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-label);
  }
  th:first-child {
    text-align: left;
    padding-left: 0;
  }
  tbody th {
    color: var(--text-strong);
    font-weight: 600;
  }
  tbody td {
    color: var(--text-strong);
    font-size: 1.05rem;
  }
  /* the visitor's setup: its column and row get a faint band, its cell a green frame */
  table :global(.you-col) {
    background: rgb(35 183 121 / 0.06);
  }
  tbody :global(tr.you-row) th,
  tbody :global(tr.you-row) td {
    background: rgb(35 183 121 / 0.06);
  }
  tbody :global(td.you-cell) {
    box-shadow: inset 0 0 0 2px var(--green);
    color: var(--text-accent);
    font-weight: 700;
  }
  thead :global(th.you-col) {
    color: var(--text-accent);
  }
  .you {
    min-height: 1.5em;
    font-size: 0.82rem;
    color: var(--text-strong);
  }
  .you:global([data-state='here'])::before {
    content: '● ';
    color: var(--green);
  }
  .you:global([data-state='off'])::before {
    content: '○ ';
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--text);
  }
  .evidence {
    display: grid;
    gap: 1.1rem;
  }
  .evidence ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .evidence li {
    display: grid;
    gap: 0.3rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .ev-fig {
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.2rem);
    font-weight: 700;
    color: var(--text-accent);
    line-height: 1.1;
  }
  .ev-text {
    color: var(--text-strong);
  }
  /* the pair to scale: 0.45 is 0.2 % of 206, so its bar is a hairline */
  .bars {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.5rem;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: center;
  }
  .bar-l,
  .bar-n {
    font-size: 0.74rem;
    color: var(--text-label);
  }
  .bar-l {
    text-align: right;
    color: var(--text-strong);
  }
  .bar-track {
    position: relative;
    height: 10px;
    border-left: 1px solid var(--line-strong);
  }
  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: max(1px, var(--w));
    background: var(--paper);
    transform-origin: left center;
  }
  .bar-seen {
    background: var(--green);
  }
  :global(html.js.reveals[data-motion='on']:not(.reveal-fail) .evidence:not(.in) .bar) {
    transform: scaleX(0);
  }
  :global(html.js.reveals[data-motion='on']) .evidence:global(.in) .bar {
    transition: transform 1.1s var(--ease-out) 450ms;
  }
  .ev-src {
    font-size: 0.82rem;
    color: var(--text-label);
  }
  @media (hover: hover) and (pointer: fine) {
    tbody tr:hover td,
    tbody tr:hover th {
      background: rgb(248 242 239 / 0.03);
    }
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    th,
    td {
      padding: 0.75rem 0.3rem;
      white-space: nowrap;
    }
    tbody td,
    tbody th {
      font-size: 0.84rem;
    }
    thead th {
      white-space: normal;
    }
  }
</style>
