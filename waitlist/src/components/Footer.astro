---
import { brand, footer as F, hero } from '../copy/en.ts';
import { assertBuildEnv } from '../lib/buildenv.mjs';
import markUrl from '../assets/numera-mark.svg?url';
import { ICON_VIEWBOX, TELEGRAM_PATH, X_PATH } from '../lib/icons.ts';
// The two contact accounts as icon-only links (inline SVG: no external request, CSP unchanged); the accessible
// name is the aria-label, and each link is a 44 px tap target with a visible focus ring.
const socials = [
  { ...F.telegram, path: TELEGRAM_PATH },
  { ...F.x, path: X_PATH },
];
// The "Source" link (network users are offered the source) points at the PUBLIC repository,
// from SITE_SOURCE_URL; without it (dev) the placeholder shows as text, never a link and never a guessed address.
const { sourceUrl } = assertBuildEnv();
---

<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <img src={markUrl} width="40" height="40" alt={brand.markAlt} />
      <p class="foot-name"><span>{brand.name}</span> · {brand.product}</p>
    </div>
    <ul class="foot-links">
      <li class="socials">
        {
          socials.map((o) => (
            <a class="icon-link" href={o.href} target="_blank" rel="noopener noreferrer" aria-label={o.aria}>
              <svg viewBox={ICON_VIEWBOX} width="22" height="22" aria-hidden="true" focusable="false"><path d={o.path} fill-rule="evenodd" /></svg>
            </a>
          ))
        }
      </li>
      <li><a href="/privacy">{F.privacy}</a></li>
      <li><a href="/terms">{F.terms}</a></li>
    </ul>
    <ul class="foot-facts mono">
      <li>{F.agri}</li>
      <li>{F.license}</li>
      <li>
        {
          sourceUrl ? (
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer">{F.source}</a>
          ) : (
            <span>{F.source}: {'{{SOURCE_URL}}'}</span>
          )
        }
      </li>
      <li>
        {F.fonts}
        {F.fontLicenses.map((l, i) => (
          <>
            {i ? ', ' : ' '}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </li>
      <li>{F.built}</li>
    </ul>
    <p class="pill foot-pill">{hero.status}</p>
    <p class="foot-note">{F.affiliation}</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-block: 3.5rem 3rem;
  }
  .foot-in {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .foot-brand {
    display: grid;
    gap: 0.8rem;
  }
  .foot-brand img {
    width: 40px;
    height: 40px;
  }
  .foot-name {
    color: var(--text-label);
    font-size: 0.92rem;
  }
  .foot-name span {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.2em;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-strong);
  }
  .socials {
    display: flex;
    gap: 0.5rem;
  }
  .foot-links .icon-link {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--text-strong);
    transition: border-color var(--t-ui) var(--ease-out), color var(--t-ui) var(--ease-out);
  }
  .icon-link svg {
    fill: currentColor;
  }
  .icon-link:focus-visible {
    outline: var(--focus);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .icon-link:hover {
      border-color: var(--green);
      color: var(--text-accent);
    }
  }
  .foot-facts {
    font-size: 0.8rem;
    color: var(--text-label);
    gap: 0.7rem;
    padding-top: 0.7rem;
  }
  .foot-facts a {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-block;
    padding-block: 0.35rem;
  }
  .foot-pill {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 0.68rem;
  }
  .foot-note {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: var(--text-label);
  }
  @media (max-width: 760px) {
    .foot-in {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
