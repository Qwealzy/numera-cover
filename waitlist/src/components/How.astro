---
// S3, how it works: six parts as an ARIA tablist over one shared stage (build spec 2.2 S3). Without JS every
// panel is shown as a list; with JS the selected panel shows and the stage works harder on that part.
import { steps, how as Hw, instrument as I } from '../copy/en.ts';
import { DEFAULT_SETUP, estimate } from '../lib/pricing.ts';
import { cascade } from '../lib/cascade.ts';

const rows = cascade(DEFAULT_SETUP, estimate(DEFAULT_SETUP));
const st = Hw.station;
---

<section id="how" class="section how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="kicker">{Hw.kicker}</p>
      <h2 id="how-title">{Hw.heading}</h2>
      <p class="intro">{Hw.intro}</p>
    </div>

    <div class="parts" data-parts data-reveal>
      <div class="tabs" role="tablist" aria-label={Hw.tablist}>
        {
          steps.map((s, i) => (
            <button
              type="button"
              role="tab"
              class="tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? '0' : '-1'}
              data-step={s.id}
            >
              <span class="tab-n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="tab-l">{s.label}</span>
            </button>
          ))
        }
      </div>

      <div class="stage-box" aria-hidden="true">
        <canvas class="stage-canvas" data-stage-canvas></canvas>
      </div>

      <div class="panels">
        {
          steps.map((s, i) => (
            <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-panel={s.id} tabindex="0">
              <p class="caption" data-caption>
                <span class="cap-n mono">{String(i + 1).padStart(2, '0')}</span> {s.text}
              </p>
              <div class="detail">
                {s.id === 'quote' && (
                  <p class="d-line"><strong>{st.quote.title}.</strong> {st.quote.note}</p>
                )}
                {s.id === 'buy' && (
                  <div class="cascade" data-cascade>
                    <p class="d-line">
                      <strong>{st.buy.title}</strong> <span class="tag tag-sim">{st.buy.note}</span>
                    </p>
                    <p class="engine-row" data-engine data-state="fail" hidden>
                      <span class="glyph" aria-hidden="true" />
                      <span>{Hw.checks.engine}</span>
                      <span class="c-state mono">{st.buy.fail}</span>
                    </p>
                    <ol class="checks" data-checks>
                      {rows.map((r) => (
                        <li data-state={r.state}>
                          <span class="glyph" aria-hidden="true" />
                          <span class="c-text">{r.text}</span>
                          <span class="c-state mono">{r.stateText}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="c-end mono" data-cascade-end>{st.buy.done}</p>
                    <p class="c-foot">{Hw.engineFoot}</p>
                  </div>
                )}
                {s.id === 'oracle' && (
                  <div class="oracle">
                    <p class="d-line"><strong>{st.oracle.title}.</strong> {st.oracle.note}</p>
                    <p class="oracle-read">
                      <span class="tag tag-live" data-oracle-tag data-state="waiting">{I.liveWaiting}</span>
                      <span class="oracle-px mono" data-oracle-px>…</span>
                    </p>
                  </div>
                )}
                {s.id === 'keeper' && (
                  <p class="d-line"><strong>{st.keeper.title}.</strong> {st.keeper.note}</p>
                )}
                {s.id === 'pool' && (
                  <p class="d-line"><strong>{st.pool.title}.</strong> {st.pool.note}</p>
                )}
                {s.id === 'payout' && (
                  <p class="d-line"><strong>{st.payout.title}.</strong> {st.payout.note}</p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="rules" data-reveal>
      <p><span class="r-mark" aria-hidden="true"></span>{Hw.rule}</p>
      <p><span class="r-mark hollow" aria-hidden="true"></span>{Hw.caveat}</p>
    </div>

    <div class="only" data-reveal>
      <h3>{Hw.only.heading}</h3>
      <ol>
        {Hw.only.items.map((t) => <li>{t}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .parts {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .tabs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
  }
  .tab {
    display: grid;
    gap: 0.15rem;
    justify-items: start;
    min-height: 64px;
    padding: 0.7rem 0.85rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--t-ui) var(--ease-out), background-color var(--t-ui) var(--ease-out),
      color var(--t-ui) var(--ease-out);
  }
  .tab:hover {
    border-color: var(--line-strong);
    color: var(--text-strong);
  }
  .tab[aria-selected='true'] {
    border-color: var(--green);
    background: rgb(35 183 121 / 0.08);
    color: var(--text-strong);
  }
  .tab-n {
    font-size: 0.7rem;
    color: var(--text-label);
  }
  .tab[aria-selected='true'] .tab-n {
    color: var(--text-accent);
  }
  .tab-l {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
  }
  .stage-box {
    position: relative;
    height: clamp(190px, 22vw, 250px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: rgb(12 21 32 / 0.5);
    overflow: hidden;
  }
  .stage-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(html:not(.js)) .stage-box {
    display: none;
  }
  .panels {
    display: grid;
  }
  .panel {
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 0 0.4rem;
    border-radius: 8px;
  }
  .panel[hidden] {
    display: none;
  }
  .caption {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.65rem);
    line-height: 1.32;
    color: var(--text-strong);
    max-width: 52rem;
    font-weight: 500;
    text-wrap: pretty;
  }
  .cap-n {
    font-size: 0.9rem;
    color: var(--text-accent);
    vertical-align: 0.25em;
    margin-right: 0.3rem;
  }
  :global(html.js[data-motion='on']) .panel .caption.swap {
    animation: cap-rise 520ms var(--ease-out);
  }
  @keyframes cap-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .d-line {
    color: var(--text);
    max-width: 52rem;
  }
  .checks {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
    max-width: 56rem;
  }
  .checks li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    font-size: 0.93rem;
    color: var(--text);
  }
  .checks li:nth-child(odd) {
    background: rgb(248 242 239 / 0.025);
  }
  .glyph {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    justify-self: center;
  }
  .engine-row {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    outline: 1.5px dashed var(--line-strong);
    outline-offset: -1px;
    color: var(--text-strong);
    max-width: 56rem;
  }
  .engine-row[hidden] {
    display: none;
  }
  .engine-row .glyph {
    border: 2px solid var(--paper);
    width: 14px;
    height: 14px;
  }
  .c-foot {
    font-size: 0.82rem;
    color: var(--text-label);
    max-width: 52rem;
  }
  li[data-state='pass'] .glyph {
    background: var(--green);
  }
  li[data-state='fail'] .glyph {
    border: 2px solid var(--paper);
    width: 14px;
    height: 14px;
  }
  li[data-state='chain'] .glyph {
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: var(--text-label);
  }
  li[data-state='skip'] {
    opacity: 0.45;
  }
  li[data-state='skip'] .glyph {
    border: 1px dashed var(--text-label);
  }
  li[data-state='fail'] {
    outline: 1.5px dashed var(--line-strong);
    outline-offset: -1px;
    color: var(--text-strong);
  }
  .c-state {
    font-size: 0.72rem;
    color: var(--text-label);
    text-align: right;
  }
  li[data-state='pass'] .c-state {
    color: var(--text-accent);
  }
  li[data-state='fail'] .c-state {
    color: var(--text-strong);
    font-weight: 700;
  }
  :global(html.js[data-motion='on']) .checks.run li {
    animation: check-in 420ms var(--ease-out) both;
    animation-delay: calc(var(--k, 0) * 55ms);
  }
  @keyframes check-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }
  .c-end {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--text-strong);
  }
  .oracle-read {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }
  .oracle-px {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    font-weight: 700;
    color: var(--text-strong);
  }
  .rules {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.6rem;
    padding: 1.2rem 1.3rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .rules p {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    color: var(--text-strong);
  }
  .r-mark {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
    transform: translateY(1px);
  }
  .r-mark.hollow {
    background: transparent;
    border: 2px solid var(--paper);
  }
  .only {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .only h3 {
    font-size: clamp(1.4rem, 1rem + 1.2vw, 1.9rem);
    font-stretch: 82%;
  }
  .only ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    counter-reset: only;
  }
  .only li {
    counter-increment: only;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    color: var(--text);
  }
  .only li::before {
    content: counter(only, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-accent);
  }
  @media (max-width: 860px) {
    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .only ol {
      grid-template-columns: minmax(0, 1fr);
    }
    .checks li {
      grid-template-columns: 18px minmax(0, 1fr);
    }
    .c-state {
      grid-column: 2;
      text-align: left;
    }
    .stage-box {
      height: 280px;
    }
  }
</style>
