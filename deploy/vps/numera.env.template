# /etc/numera/numera.env  (mode 600, owner root). Read by systemd for numera-engine and numera-keeper.
#
# Rules for this file
#  - One KEY=value per line, no quotes, no spaces around "=", comments on their own lines (systemd does not
#    support trailing comments).
#  - Secrets (QUOTE_SIGNER_KEY, KEEPER_KEY) are typed here on the server only. Never copy this file anywhere,
#    never paste it into a chat, never commit it. Edit with: sudo nano /etc/numera/numera.env
#  - After any change: sudo systemctl restart numera-engine numera-keeper
#  - TESTNET ONLY. The units refuse to start unless NUMERA_CHAIN_ID=998 and NUMERA_ENV=testnet.

# ---- Network (do not change) -------------------------------------------------------------------------------
# Environment name: picks deployments/testnet.json (+ testnet-v2.json) from the checkout in /opt/numera.
NUMERA_ENV=testnet
# HyperEVM testnet. The engine also checks that the RPC answers this chain id and refuses to start otherwise.
NUMERA_CHAIN_ID=998
# JSON-RPC endpoints, comma separated, tried in order (failover). Official testnet RPC first, Chainlink second.
NUMERA_RPCS=https://rpc.hyperliquid-testnet.xyz/evm,https://rpcs.chain.link/hyperevm/testnet

# ---- Secrets (YOU fill these in on the server) -------------------------------------------------------------
# Quote signer: the engine signs cover quotes with it. Its address must be the quoteSigner the pools were
# deployed with (GET /health shows the address the engine uses). Used by numera-engine only.
QUOTE_SIGNER_KEY=
# Keeper: sends trigger/expire transactions. Needs testnet HYPE for gas. Used by numera-keeper only.
KEEPER_KEY=

# ---- Quote API behind Cloudflare Tunnel (audit M1) ---------------------------------------------------------
# uvicorn listens on loopback only; cloudflared (same host) is the only way in.
NUMERA_BIND_HOST=127.0.0.1
# "proxy" = a reverse proxy sits in front, so the engine refuses to start without NUMERA_TRUSTED_PROXIES.
NUMERA_PROXY_MODE=proxy
# The only trusted proxy: cloudflared connecting from this machine.
NUMERA_TRUSTED_PROXIES=127.0.0.1,::1
# Header Cloudflare sets to the real visitor IP. Believed only when the connection comes from a trusted proxy;
# the rate limiter then keys on it (10 quotes/min per client by default).
NUMERA_CLIENT_IP_HEADER=CF-Connecting-IP
# Optional rate limit tuning (defaults: 10 per minute, burst 5).
# NUMERA_RATE_PER_MIN=10
# NUMERA_RATE_BURST=5

# ---- CORS: which web pages may call the Quote API -----------------------------------------------------------
# The trader app plus the local Vite dev server. Comma separated, exact origins, no trailing slash.
NUMERA_CORS_ORIGINS=https://app.numeralabs.xyz,http://localhost:5173,http://127.0.0.1:5173

# ---- Pools (read from the repo, never typed here) ------------------------------------------------------------
# Leave EMPTY. On chain 998 the engine then signs only for the v2 pools listed in deployments/testnet-v2.json
# of the checkout, and the keeper watches exactly those. After a redeploy: update the checkout (numera-update).
# The units refuse to start if this is set, unless NUMERA_ALLOW_POOL_OVERRIDE=1.
NUMERA_POOLS=
# Keeper: watch only the deployments file's v2 pools (the v1 pools in testnet.json are not watched).
NUMERA_KEEPER_POOL_VERSION=v2
# Optional keeper tuning: NUMERA_KEEPER_FAST_POLL, see engine/numera_engine/keeper.py --help.
