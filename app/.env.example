# Copy to app/.env.local to override. Every value has a default in src/config.ts.

# Quote engine (docs/how-it-works.md §6). One engine instance signs for ONE pool (its NUMERA_POOL),
# so the two pools can point at two engine instances. Unset → VITE_ENGINE_URL.
VITE_ENGINE_URL=http://localhost:8000
# Dev server only: VITE_ENGINE_URL=/engine goes through the Vite proxy to NUMERA_ENGINE_PROXY
# (default http://localhost:8000), so an engine without CORS works too.
# VITE_ENGINE_URL_HYPERCORE=http://localhost:8000
# VITE_ENGINE_URL_MOCK=http://localhost:8001

# 1 = never call the engine; answer /quote from a local fixture shaped like §6 (signature is fake,
# so buyCover will revert with InvalidSignature — fixture mode is for UI work only).
VITE_USE_QUOTE_FIXTURE=0

# Waitlist form for the About page CTA (hidden when unset)
# VITE_WAITLIST_URL=https://…

# Testnet endpoints (defaults shown)
# VITE_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# VITE_INFO_URL=https://api.hyperliquid-testnet.xyz/info

# Read-only fallback RPCs, comma list. Default: https://rpcs.chain.link/hyperevm/testnet when VITE_RPC_URL is the
# default official RPC. Empty value disables the fallback. Each fallback must answer chain id 998 or it is not
# used. A circuit breaker on the official RPC routes reads to the fallback while it rate-limits or is down;
# signed values and transactions never use the fallback.
# VITE_RPC_FALLBACK_URLS=https://rpcs.chain.link/hyperevm/testnet

# Block explorer base URL (links /tx/<hash> and /address/<addr>). Empty on purpose: as of 2026-10-02 there
# is no working HyperEVM testnet (998) explorer. The hyperpc Blockscout indexer is stale (stuck at block
# 60,609,357, 2026-08-03, so every recent tx shows "Not found") and hypurrscan's EVM view does not find our
# txs. While empty, the app renders no external links: a tx hash opens an in-app receipt read with
# eth_getTransactionReceipt from the RPC, and addresses get a copy button. Set it only to an explorer that
# actually indexes chain 998.
VITE_EXPLORER_URL=
