# Copy to .env and fill in. .env is gitignored and the agent is blocked from writing it.
# TESTNET ONLY (chain 998). Use fresh keys that never hold mainnet funds.

# Network
RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
CHAIN_ID=998
INFO_API=https://api.hyperliquid-testnet.xyz/info

# Deployer (needs testnet HYPE for gas)
DEPLOYER_KEY=

# Engine quote signer (address goes to the pool as quoteSigner; key stays with the engine)
QUOTE_SIGNER_KEY=

# Keeper (calls trigger/expire; needs a little testnet HYPE)
KEEPER_KEY=

# Filled after deployment (deployments/testnet.json is the source of truth)
POOL_ADDRESS=
USDC_ADDRESS=
